# KernelSU Action -- build profile for Xiaomi Mi 6 (sagit) on LineageOS 19.1
# Target OS: LineageOS 19.1 (Android 12) with Docker / Droidspaces / LXC Support
#
# The lineage-19.1 branch of this kernel is plain 4.4.302 (no 5.x VFS
# backports -- ENABLE_PATH_UMOUNT backports path_umount() for the KSU link).
# sagit_defconfig carries CONFIG_LOCALVERSION="-perf" and has
# CONFIG_LOCALVERSION_AUTO unset, so the built kernel reports
# 4.4.302-perf -- the exact vermagic the LOS 19.1 vendor modules are built
# against, on any commit of this branch.

CONFIG_ENV=config-los191-sagit.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_msm8998
KERNEL_SOURCE_BRANCH=lineage-19.1
KERNEL_CONFIG=sagit_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

KERNEL_NAME=sagit-los191-ksu

ADD_LOCALVERSION_TO_FILENAME=true

# Extra flags appended to every make invocation.
# IMPORTANT: this value is passed to make UNQUOTED, so it must be a single
# "VAR=value" token with no spaces. Multiple -Wno-error=<class> flags cannot
# be written here -- the bare "-Wno-error" token already covers them all
# (it demotes every warning, so no warning can fail the build).
EXTRA_CMDS:KCFLAGS=-Wno-error
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# Clang 12 (r416183b) is the right compiler for this 4.4-era tree.
# master-kernel-build-2021 is the branch that actually populates
# clang-r416183b (it is in scripts/toolchain.sh's verified-good table).
# If android.googlesource.com is having an outage (its +archive endpoint
# 503s for hours at a time), toolchain.sh automatically falls back to the
# NDK toolchain on dl.google.com (Clang 16, set CLANG_NDK_VERSION to change
# the version) and, for the GCC 4.9 binutils, to the runner's system
# aarch64-linux-gnu / arm-linux-gnueabi cross binutils.
CLANG_BRANCH=master-kernel-build-2021
CLANG_VERSION=r416183b

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

DISABLE_CC_WERROR=true

# =============================================================== KernelSU ===
# Baseline (variant=none) built green on 2026-09-28, run #15 -- now on the
# real variant.
#
# For this 4.4 kernel the correct variant is 'kernelsu' (tiann/KernelSU),
# which auto-pins v0.9.5 -- the last release that supports non-GKI kernels.
# Do NOT use 'resukisu' here: ReSukiSU_Patches ships scope-minimized hook
# patches for 4.9/4.14/4.19/6.6 only, so on 4.4 its manual hooks are never
# patched in and the build is pointless.
KSU_VARIANT=kernelsu
KSU_REF=v0.9.5

# 4.4 kernels must use manual hook mode
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# Backport of path_umount() (kernel 5.9+). The action is idempotent: if this
# tree's heavily backported VFS already provides it, the step is a no-op.
# Needed so tiann/KernelSU 0.9.x (which unconditionally externs path_umount)
# can link.
ENABLE_PATH_UMOUNT=true

ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false

# --- Docker & Droidspaces & Container Config Injections ---
# CONFIG_POSIX_MQUEUE=n on purpose: the 4.4 msm8998 tree panics in
# sget_userns (alignment fault on a corrupted pointer) when the container
# unshare(CLONE_NEWIPC) mounts the mqueue fs via mq_init_ns. Leaving it
# off makes mq_init_ns an inline no-op (include/linux/ipc_namespace.h) so
# the crash path never runs. Verified: the 4.14 cannon kernel handles the
# same path fine; this is a 4.4-only bug exposed by our IPC_NS/USER_NS adds.
EXTRA_DEFCONFIG=CONFIG_NAMESPACES=y CONFIG_PID_NS=y CONFIG_IPC_NS=y CONFIG_NET_NS=y CONFIG_USER_NS=y CONFIG_POSIX_MQUEUE=n CONFIG_CGROUPS=y CONFIG_MEMCG=y CONFIG_MEMCG_SWAP=y CONFIG_MEMCG_SWAP_ENABLED=y CONFIG_MEMCG_KMEM=y CONFIG_CGROUP_DEVICE=y CONFIG_CGROUP_PIDS=y CONFIG_CGROUP_SCHED=y CONFIG_FAIR_GROUP_SCHED=y CONFIG_CGROUP_FREEZER=y CONFIG_CGROUP_NET_PRIO=y CONFIG_VETH=y CONFIG_BRIDGE=y CONFIG_BRIDGE_NETFILTER=y CONFIG_NETFILTER_ADVANCED=y CONFIG_NF_CONNTRACK=y CONFIG_IP_NF_IPTABLES=y CONFIG_IP_NF_FILTER=y CONFIG_NF_NAT=y CONFIG_IP_NF_TARGET_MASQUERADE=y CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y CONFIG_OVERLAY_FS=y CONFIG_DEVTMPFS=y CONFIG_TMPFS_POSIX_ACL=y CONFIG_TMPFS_XATTR=y CONFIG_EXT4_FS_POSIX_ACL=y CONFIG_ANDROID_PARANOID_NETWORK=n CONFIG_KPROBES=n
#   ^ CONFIG_KPROBES=n: KernelSU v0.9.5 compiles its manual-hook API
#     (ksu_vfs_read_hook/ksu_execveat_hook bools + ksu_handle_* entry
#     points) ONLY when CONFIG_KPROBES is disabled; with kprobes on it
#     self-hooks via kprobes and the manual calls in fs/read_write.c /
#     fs/exec.c left undefined symbols at the vmlinux link (run #16).

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
