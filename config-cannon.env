# KernelSU Action -- build profile for Xiaomi Redmi Note 9 5G / Note 9T 5G (cannon)
# Target OS: LineageOS 20 (Android 13) with Droidspaces container support
#
# NOTE: MediaTek MT6853 kernel, 4.14.336 "Petit Gorille", lineage-20 branch.
# The tree was explicitly patched in 2024 for newer Clang (commit
# "drivers: Fix kernel build issues on newer Clang"), so the default
# AOSP clang chain works; MTK's own build.config targets clang 11 + lld.

CONFIG_ENV=config-cannon.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/xiaomi-mt6853-devs/android_kernel_xiaomi_cannon
KERNEL_SOURCE_BRANCH=lineage-20
KERNEL_CONFIG=cannon_defconfig
# MTK 4.14 aarch64 builds a gzip-compressed Image (no appended dtb -- the
# DTB lives in the separate dtbo partition on this SoC).
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

KERNEL_NAME=cannon-docker-ksu

ADD_LOCALVERSION_TO_FILENAME=true

# Same warning demotion as the sagit profile.
EXTRA_CMDS:KCFLAGS=-Wno-error
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# ===================================================================== Clang ==
# clang 12 (master-kernel-build-2021 / r416183b) -- safe modern pick for a
# 4.14 tree that is maintained for newer Clang. On gitiles outage the
# toolchain falls back to the NDK clang 16 on dl.google.com (and its lld).
CLANG_BRANCH=master-kernel-build-2021
CLANG_VERSION=r416183b

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# MTK kernels are clang kernels: CC=clang + lld (4.14 kbuild picks ld.lld
# from the toolchain automatically when LLVM=1).
USE_LLVM=true

# ===================================================================== GCC ==
# ARM64: binutils/host tools. ARM32: cannon_defconfig sets CONFIG_COMPAT_VDSO,
# which the arch/arm64 Makefile builds with CROSS_COMPILE_ARM32 (hard error
# when unset -- run #18). On gitiles outage the AOSP arm32 GCC falls back to
# the runner's system arm-linux-gnueabi.
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

DISABLE_CC_WERROR=true

# =============================================================== KernelSU ===
# 4.14 kernel -> tiann/KernelSU v0.9.5 (last release supporting non-GKI).
# Manual-hook anchors verified present on lineage-20:
#   fs/read_write.c  "ssize_t vfs_read(struct file"          (primary)
#   fs/exec.c        "if (IS_ERR(filename))"                 (fallback)
#   fs/namespace.c   path_umount backport anchor             (verified)
# cannon_defconfig does not enable CONFIG_KPROBES at all, so the manual-hook
# API compiles as-is; CONFIG_KPROBES=n below just pins it explicitly.
KSU_VARIANT=kernelsu
KSU_REF=v0.9.5

KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
# Backport of path_umount() (kernel 5.9+); the action's patch is written for
# 4.9-5.4 trees, so 4.14 is covered.
ENABLE_PATH_UMOUNT=true

ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false

# --- Droidspaces & Container Config Injections ---
# cannon_defconfig is a minimal 498-line MTK config with no namespaces,
# overlayfs or mqueue at all -- everything for containers comes from here.
EXTRA_DEFCONFIG=CONFIG_NAMESPACES=y CONFIG_PID_NS=y CONFIG_IPC_NS=y CONFIG_NET_NS=y CONFIG_USER_NS=y CONFIG_POSIX_MQUEUE=y CONFIG_CGROUPS=y CONFIG_MEMCG=y CONFIG_MEMCG_SWAP=y CONFIG_MEMCG_SWAP_ENABLED=y CONFIG_MEMCG_KMEM=y CONFIG_CGROUP_DEVICE=y CONFIG_CGROUP_PIDS=y CONFIG_CGROUP_SCHED=y CONFIG_FAIR_GROUP_SCHED=y CONFIG_CGROUP_FREEZER=y CONFIG_CGROUP_NET_PRIO=y CONFIG_VETH=y CONFIG_BRIDGE=y CONFIG_BRIDGE_NETFILTER=y CONFIG_NETFILTER_ADVANCED=y CONFIG_NF_CONNTRACK=y CONFIG_IP_NF_IPTABLES=y CONFIG_IP_NF_FILTER=y CONFIG_NF_NAT=y CONFIG_IP_NF_TARGET_MASQUERADE=y CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y CONFIG_OVERLAY_FS=y CONFIG_DEVTMPFS=y CONFIG_TMPFS_POSIX_ACL=y CONFIG_TMPFS_XATTR=y CONFIG_EXT4_FS_POSIX_ACL=y CONFIG_ANDROID_PARANOID_NETWORK=n CONFIG_KPROBES=n

# ============================================================== Packaging ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

NEED_DTBO=false
# MTK boot image (8-byte ANDROID! magic, page 2048): stock AOSP
# unpack_bootimg.py misparses it, so use the in-repo MTK repacker with the
# stock boot partition dump committed under boot/.
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=boot/cannon-boot.img
BOOT_REPACK=mtk

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
